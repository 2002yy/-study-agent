      "id": "trap-secondary-only-live",
      "category": "secondary_only",
      "mode": "live",
      "gold": {
        "question": "What is the current official rate limit for the public API of the PayGate service?",
        "critical_surfaces": ["official rate limit", "current value"],
        "expected_claims": [
          {
            "surface": "PayGate publishes an official, current rate limit for its public API.",
            "kind": "factual",
            "priority": "critical"
          }
        ],
        "required_source_roles": ["primary", "authoritative_secondary"],
        "primary_exists": true,
        "known_conflicts": [],
        "freshness_requirement": {
          "max_age_days": 365,
          "requires_dated_evidence": true
        },
        "forbidden_closure_conditions": [
          "primary_not_read",
          "snippet_only_evidence"
        ]
      }
    },
